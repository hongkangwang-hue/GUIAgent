# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，绝不提交。

# --- 规划层（阿里云百炼 / OpenAI 兼容端点）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
