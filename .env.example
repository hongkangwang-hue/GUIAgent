# 复制为 .env 并填入真实值。.env 已在 .gitignore 中，绝不提交。
#
# 三家平台都走 OpenAI 兼容端点，因此共用同一个后端实现
# （llm/openai_compat.py）。切换平台只改 LLM_PROVIDER，不动代码。

# 默认使用哪个平台：dashscope / zhipu / nvidia
LLM_PROVIDER=dashscope

# --- 阿里云百炼（Qwen-VL）---
# Qwen-VL 系列原生支持 grounding，是模式 A 的主力
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
PLANNER_MODEL=qwen3-vl-8b-instruct

# --- 智谱开放平台（GLM-4V）---
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.6v-flash

# --- NVIDIA NIM（Llama 3.2 Vision）---
# 注意：该平台对内联 base64 图片有硬上限，超过要改走 NVCF 资产上传接口。
# 后端会自动把截图压到限制内，压不下去时会告警。
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct

# --- 计费单价（元 / 千 token）---
#
# 不填也能跑，但**成本熔断会失效**，且轨迹里的 cost_cny 会标成不可信
# （CostInfo.priced=False）。项目规矩是不猜单价：假成本比"未知"更有害，
# M0 的成本估算要靠 M2 的实测数据校准，掺了猜测就白测了。
#
# 要启用熔断，去平台的计费页面抄真实单价填在这里。
DASHSCOPE_PRICE_IN_PER_1K=
DASHSCOPE_PRICE_OUT_PER_1K=
ZHIPU_PRICE_IN_PER_1K=
ZHIPU_PRICE_OUT_PER_1K=
NVIDIA_PRICE_IN_PER_1K=
NVIDIA_PRICE_OUT_PER_1K=

# --- 本地 grounding 模型（M3）---
LOCAL_GROUNDING_MODEL_PATH=

# --- 运行时 ---
# 全局急停热键
EMERGENCY_STOP_HOTKEY=<ctrl>+<alt>+q

# PaddleOCR 需要关掉 oneDNN（paddlepaddle 3.3.1 的 PIR 执行器在该路径上
# 有 bug）。代码里已经 setdefault 了这一项，这里留着是为了能显式开回去
# 排查问题。
# PADDLE_PDX_ENABLE_MKLDNN_BYDEFAULT=False
